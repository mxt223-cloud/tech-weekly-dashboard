<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#002b36"><meta name="apple-mobile-web-app-capable" content="yes"><link rel="manifest" href="./manifest.webmanifest"><link rel="icon" href="./icon.svg"><title>{{data.title}}</title><style>:root{color-scheme:light dark;--bg:#fdf6e3;--card:#eee8d5;--text:#073642;--muted:#586e75;--accent:#268bd2}@media(prefers-color-scheme:dark){:root{--bg:#002b36;--card:#073642;--text:#eee8d5;--muted:#93a1a1;--accent:#2aa198}}*{box-sizing:border-box}body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--bg);color:var(--text)}main{max-width:900px;margin:auto;padding:20px 14px 60px}h1{font-size:1.8rem;margin:.2rem 0}h2{margin-top:30px;font-size:1.25rem}.meta,.stats{color:var(--muted)}.grid{display:grid;gap:10px}.card{display:block;padding:14px;border-radius:14px;background:var(--card);color:inherit;text-decoration:none}.rank{font-weight:700;color:var(--accent);margin-right:.45rem}.name{font-weight:650;overflow-wrap:anywhere}.stats{margin-top:8px;font-size:.87rem}.description{margin-top:7px;line-height:1.45}.chips{display:flex;flex-wrap:wrap;gap:6px}.chip{background:var(--card);border-radius:999px;padding:6px 10px;font-size:.85rem}</style></head><body><main><h1>{{data.title}}</h1><div class="meta">{{data.week}} / {{data.generated_at}}</div><p class="meta">GitHub順位はダウンロード数ではありません。</p><h2>GitHub Trending</h2><div class="grid">{% for r in data.github %}<a class="card" href="{{r.url}}"><div><span class="rank">{{r.rank}}</span><span class="name">{{r.full_name}}</span></div><div class="description">{{r.description or "説明なし"}}</div><div class="stats">{{r.language}} ・ 今週 ★{{r.stars_period if r.stars_period is not none else "不明"}} ・ License {{r.api.license or "不明"}}</div></a>{% endfor %}</div><h2>Zenn</h2><div class="grid">{% for x in data.zenn[:10] %}<a class="card" href="{{x.url}}"><div class="name">{{x.title}}</div><div class="stats">{{x.author or "著者不明"}} ・ {{x.published or "公開日不明"}}</div></a>{% endfor %}</div><h2>共通キーワード</h2><div class="chips">{% for t in data.common_terms %}<span class="chip">{{t}}</span>{% endfor %}</div></main><script>if('serviceWorker'in navigator)navigator.serviceWorker.register('./sw.js')</script></body></html>