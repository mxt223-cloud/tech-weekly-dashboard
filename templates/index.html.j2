<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#002b36">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="manifest" href="./manifest.webmanifest">
  <link rel="icon" href="./icon.svg">
  <title>{{ data.title }}</title>
  <style>
    :root{color-scheme:light dark;--bg:#fdf6e3;--card:#eee8d5;--text:#073642;--muted:#586e75;--accent:#268bd2;--line:#d6cfbc}
    @media(prefers-color-scheme:dark){:root{--bg:#002b36;--card:#073642;--text:#eee8d5;--muted:#93a1a1;--accent:#2aa198;--line:#164956}}
    *{box-sizing:border-box}body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--bg);color:var(--text)}
    main{max-width:920px;margin:auto;padding:20px 14px 60px}h1{font-size:1.8rem;margin:.2rem 0}h2{margin-top:30px;font-size:1.25rem}h3{font-size:1rem;margin:16px 0 7px}
    .meta,.stats,.evidence{color:var(--muted)}.grid{display:grid;gap:12px}.card{padding:16px;border-radius:14px;background:var(--card)}
    .head{display:flex;gap:8px;align-items:baseline}.rank{font-weight:700;color:var(--accent)}.name{font-weight:700;overflow-wrap:anywhere}.repo-link{color:inherit;text-decoration:none}
    .summary{margin:10px 0;line-height:1.55;font-weight:600}.stats{font-size:.86rem}.section{border-top:1px solid var(--line);margin-top:12px;padding-top:3px}
    ul,ol{padding-left:1.35rem;margin:.4rem 0}.item-note{display:block;color:var(--muted);font-size:.8rem;margin-top:2px}.warning{font-size:.86rem;color:var(--muted)}
    .chips{display:flex;flex-wrap:wrap;gap:6px}.chip{background:var(--card);border-radius:999px;padding:6px 10px;font-size:.85rem}
    details{margin-top:10px}.original{font-size:.9rem;line-height:1.45;color:var(--muted)}
  </style>
</head>
<body><main>
  <h1>{{ data.title }}</h1>
  <div class="meta">{{ data.generated_at }}</div>
  <p class="meta">READMEをGeminiで日本語分析。分析成功 {{ data.ai_analysis.successful }}/{{ data.ai_analysis.total }}件。GitHub順位はダウンロード数ではありません。</p>

  <h2>GitHub Trending</h2>
  <div class="grid">
  {% for r in data.github %}
    <article class="card">
      <div class="head"><span class="rank">{{ r.rank }}</span><a class="repo-link name" href="{{ r.url }}" target="_blank" rel="noopener">{{ r.full_name }}</a></div>
      <div class="summary">{{ r.analysis.summary_ja }}</div>
      <div class="stats">{{ r.language }} ・ 今週 ★{{ r.stars_period if r.stars_period is not none else "不明" }} ・ License {{ r.api.license or "不明" }}</div>

      {% if r.analysis.capabilities %}
      <div class="section"><h3>できること</h3><ul>
        {% for item in r.analysis.capabilities %}<li>{{ item.text }}<span class="item-note">根拠：{{ item.evidence_section }}</span></li>{% endfor %}
      </ul></div>
      {% endif %}

      {% if r.analysis.use_cases %}
      <div class="section"><h3>利用例</h3><ul>
        {% for item in r.analysis.use_cases %}<li>{{ item.text }}<span class="item-note">{{ item.basis }}／根拠：{{ item.evidence_section }}</span></li>{% endfor %}
      </ul></div>
      {% endif %}

      {% if r.analysis.first_trial.steps %}
      <div class="section"><h3>最初に試すこと</h3><div>{{ r.analysis.first_trial.goal }}</div><ol>
        {% for step in r.analysis.first_trial.steps %}<li>{{ step }}</li>{% endfor %}
      </ol><div class="evidence">成功の目安：{{ r.analysis.first_trial.success_criteria }}</div></div>
      {% endif %}

      {% if r.analysis.unconfirmed %}<div class="warning">未確認：{{ r.analysis.unconfirmed | join("／") }}</div>{% endif %}
      <details><summary>原文説明・取得情報</summary><div class="original">{{ r.description or "説明なし" }}<br>README: {{ r.readme.path or "不明" }} / AI状態: {{ r.analysis.status }}{% if r.analysis.cached %} / キャッシュ利用{% endif %}</div></details>
    </article>
  {% endfor %}
  </div>

  <h2>Zenn</h2><div class="grid">
  {% for x in data.zenn[:10] %}<a class="card repo-link" href="{{ x.url }}" target="_blank" rel="noopener"><div class="name">{{ x.title }}</div><div class="stats">{{ x.author or "著者不明" }} ・ {{ x.published or "公開日不明" }}</div></a>{% endfor %}
  </div>

  <h2>共通キーワード</h2><div class="chips">{% for t in data.common_terms %}<span class="chip">{{ t }}</span>{% endfor %}</div>
</main><script>if('serviceWorker'in navigator)navigator.serviceWorker.register('./sw.js')</script></body></html>
